# ============================================================
# Cloudflare Pages 环境变量示例（.env.example）
# 用途：
#   1. 线上：在 Cloudflare Pages 项目 → Settings → Environment variables 配置
#   2. 本地：复制为 .env（已被 .gitignore 忽略，切勿提交真实值）
# 密钥类变量请保持空值占位，真实值只存于 Pages 控制台 / 本地 .env。
# ============================================================

# --- Supabase（必填）---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_EDGE_FUNCTION_URL=

# --- 内部安全 ---
# 边缘代理共享密钥（_lib/jwt.js 校验）
EDGE_PROXY_SECRET=

# --- 注册防护 ---
# Cloudflare Turnstile 人机验证（未配置则跳过校验，fail-open）
TURNSTILE_SECRET=
# 注册 PoW 挑战签名密钥（未配置则跳过 PoW）
REGISTER_POW_SECRET=
# PoW 难度（前导零位数，可选，默认代码内取值）
REGISTER_POW_DIFFICULTY=
# 阻止 Tor 出口节点注册：on / off（默认 on）
BLOCK_TOR_REGISTRATION=on

# --- 翻译服务 ---
# 小牛翻译（主引擎，translate.js）
NIUTRANS_API_KEY=
NIUTRANS_APP_ID=
# uapis.cn 流式翻译（translate/stream.js）
UAPI_API_KEY=

# --- 语音 / MOSS ---
MOSS_API_KEY=
# 本地 ASR 服务地址（engine=local 时使用，默认 http://127.0.0.1:8101）
LOCAL_ASR_URL=http://127.0.0.1:8101

# --- 可选：AI 代理预置 key（proxy.js，未配置时用户需自带 key）---
NVIDIA_API_KEY=

# --- 可选：历史遗留（Pages 已配置，当前代码未引用，可留空）---
MATRIX_HOMESERVER=
MATRIX_BOT_USER_ID=
MATRIX_BOT_TOKEN=
MATRIX_BOT_PASSWORD=

# ============================================================
# Bindings（不是环境变量，在 Pages 控制台单独绑定）：
#   DB            -> D1 数据库
#   PAGES_BUCKET  -> R2 存储桶
#   AI            -> Workers AI
# ============================================================
